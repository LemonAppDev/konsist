{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "baseBranches": ["develop"],
  "lockFileMaintenance": { "enabled": true },
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "labels": ["maintenance"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchPackagePatterns": ["org.jetbrains.kotlin"],
      "enabled": false
    },
    {
      "matchPackagePatterns": ["org.junit.jupiter*"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Legacy Kotlin (prior to 2.4) regression test - Kotlin version is locked, see project README.md",
      "matchFileNames": ["misc/test-projects/konsist-compiler-configuration-extension-storage-tester/**"],
      "matchPackagePatterns": ["org.jetbrains.kotlin"],
      "enabled": false
    }
  ]
}
