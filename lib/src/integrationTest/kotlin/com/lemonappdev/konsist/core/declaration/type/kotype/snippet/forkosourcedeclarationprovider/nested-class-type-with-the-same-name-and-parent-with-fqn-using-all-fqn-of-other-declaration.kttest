package com.fixturepackage

interface FirstInterface {
    class NestedClass(val arg: FixtureNestedClassWithTheSameName)
    data class FixtureNestedClassWithTheSameName(val fixtureFirstParameter: String)
}

interface SecondInterface {
    class NestedClass(val arg: com.fixturepackage.FirstInterface.FixtureNestedClassWithTheSameName)
    data class FixtureNestedClassWithTheSameName(val fixtureSecondParameter: String)
}
